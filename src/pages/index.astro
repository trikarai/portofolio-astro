---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";

import RetroNav from "../components/navigation/RetroNav";
import FooterNav from "../components/navigation/FooterNav.astro";

import Welcome from "../components/Welcome.astro";
import AboutMe from "../components/AboutMe.vue";
import Experiences from "../components/Experiences.astro";
import FeaturedPortofolio from "../components/FeaturedPortofolio.svelte";
import ContactMe from "../components/ContactMe.astro";
import Skills from "../components/Skills.astro";
import Certificates from "../components/Certificates.astro";
---

<Layout>
  <div id="top"></div>
  <RetroNav client:only="react" />
  <Welcome />
  <AboutMe />
  <Skills />
  <Certificates />
  <Experiences />
  <FeaturedPortofolio />
  <ContactMe />
  <FooterNav />
</Layout>
<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
